# Copia este archivo como .env.local y rellena con los valores de tu
# proyecto de Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo para scripts de administración/backend que necesiten saltar RLS
# (ej. jobs de materialización de recurrentes). NUNCA exponer al frontend.
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Necesaria para el Asistente financiero (/dashboard/chat). Se pide en
# https://console.anthropic.com — es una clave de pago por uso, NO tiene
# relación con tu cuenta de Claude.ai. Solo se usa en el servidor
# (app/api/chat/route.ts), nunca se expone al navegador.
ANTHROPIC_API_KEY=tu-clave-de-anthropic
